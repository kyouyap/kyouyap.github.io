---
import { getEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import LangSwitcher from "@/components/LangSwitcher.astro";
import TerminalHero from "@/components/TerminalHero.astro";
import Section from "@/components/Section.astro";
import ScreenshotFigure from "@/components/ScreenshotFigure.astro";
import StackTable from "@/components/StackTable.astro";

const entry = await getEntry("projects", "pairkan");
if (!entry) throw new Error("pairkan content entry missing");

const PATHNAME = "/pairkan/";
---
<BaseLayout
  title="pairkan.com — Takuya Ogata"
  description="Solo full-stack web service case study."
  lang="ja"
  pathname={PATHNAME}
>
  <header style="display:flex; justify-content:space-between; align-items:center; margin-bottom: var(--s4)">
    <span style="color: var(--comment); font-family: var(--font-mono); font-size: var(--fs-sm)">~/pairkan</span>
    <LangSwitcher pathname={PATHNAME} />
  </header>

  <p style="font-family: var(--font-mono); font-size: var(--fs-sm); color: var(--accent-2)">
    <a href="/">[← back]</a>
  </p>

  <TerminalHero
    command="./pairkan"
    name="pairkan.com"
    role="personal · 2025—"
    tagline="A consumer-facing web service. Solo full-stack design and build."
  />

  <hr style="border:0; border-top:1px solid var(--rule); margin: var(--s8) 0" aria-hidden="true" />

  <Section id="one-liner" title="one-liner">
    <p style="font-family: var(--font-mono); font-size: var(--fs-sm); line-height: 1.7; color: var(--fg)">
      A consumer-facing web service. Solo full-stack design and build, intentionally minimal for one-person economics.
    </p>
    {/* TODO(spec §6.2/§6.3): 業界・ユーザーセグメントを明示せず、技術と構造で記述する。 */}
  </Section>

  <Section id="screenshots" title="screenshots">
    <ScreenshotFigure src="/pairkan/01-hero.png"        alt="pairkan hero shot"    width={1200} height={750} caption="hero shot" />
    <ScreenshotFigure src="/pairkan/02-onboarding.png"  alt="pairkan onboarding"   width={1200} height={750} caption="onboarding flow" />
    <ScreenshotFigure src="/pairkan/03-main.png"        alt="pairkan main UI"      width={1200} height={750} caption="main UI" />
    <ScreenshotFigure src="/pairkan/04-detail.png"      alt="pairkan detail view"  width={1200} height={750} caption="result / detail" />
  </Section>

  <Section id="problem-design-build" title="problem → design → build">
    <ul style="list-style:none; padding:0; margin:0; font-family: var(--font-mono); font-size: var(--fs-sm); line-height: 1.7">
      <li>- <b>problem.</b> _to be written._</li>
      <li>- <b>design.</b> _to be written._</li>
      <li>- <b>build.</b> _to be written._</li>
    </ul>
  </Section>

  <Section id="stack" title="stack & trade-offs">
    <StackTable
      rows={[
        { axis: "frontend",   chosen: "Next.js (App)",        considered: "Astro · SvelteKit",       why: "SSR + auth in one runtime" },
        { axis: "db / auth",  chosen: "Supabase",             considered: "Postgres + Auth0",        why: "1 vendor reduces ops surface" },
        { axis: "api",        chosen: "Next.js Route Hndl",   considered: "Hono on Cloudflare",      why: "minimize context switching for solo dev" },
        { axis: "hosting",    chosen: "Vercel",               considered: "CF Pages · Fly",          why: "free tier + DX" },
        { axis: "analytics",  chosen: "(none yet)",           considered: "Posthog · Plausible",     why: "prioritize shipping first" },
      ]}
      note={"at scale, auth and heavy compute would split out to Hono.\nThe current minimalism is intentional — cost, speed, single-person cognitive load."}
    />
  </Section>

  <Section id="next" title="current state · what's next">
    <ul style="list-style:none; padding:0; margin:0; font-family: var(--font-mono); font-size: var(--fs-sm); line-height: 1.7">
      <li>- live: <a href="https://pairkan.com">pairkan.com</a></li>
      <li>- recent ship: _to be written._</li>
      <li>- next:        _to be written._</li>
    </ul>
  </Section>

  <Section id="links" title="links">
    <pre style="margin:0; color: var(--comment); font-family: var(--font-mono); font-size: var(--fs-sm)">$ ls links/</pre>
    <ul style="list-style:none; padding:0; margin: var(--s2) 0; font-family: var(--font-mono); font-size: var(--fs-sm)">
      <li>demo  → <a href="https://pairkan.com" target="_blank" rel="noopener">https://pairkan.com</a></li>
      <li>repo  → (private)</li>
    </ul>
  </Section>
</BaseLayout>
