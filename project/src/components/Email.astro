---
// project/src/components/Email.astro
import { rot13 } from "@/lib/rot13";

const PLAIN = "kyouyap@gmail.com";
const ENC = rot13(PLAIN); // "xlbhlnc@tznvy.pbz"
const DISPLAY = PLAIN.replace("@", " [at] ").replace(/\.([a-z]+)$/, " [dot] $1");
---
<a
  class="email"
  href={`#${ENC}`}
  data-enc={ENC}
  rel="nofollow"
>{DISPLAY}</a>

<script is:inline>
  document.addEventListener('click', function (e) {
    const a = e.target instanceof Element ? e.target.closest('a.email') : null;
    if (!a) return;
    e.preventDefault();
    const enc = a.getAttribute('data-enc') || '';
    const dec = enc.replace(/[a-zA-Z]/g, function (c) {
      const base = c <= 'Z' ? 65 : 97;
      return String.fromCharCode(((c.charCodeAt(0) - base + 13) % 26) + base);
    });
    window.location.href = 'mailto:' + dec;
  });
</script>

<style>
  .email { font-family: var(--font-mono); }
</style>
