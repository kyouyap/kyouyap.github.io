---
// project/src/components/Section.astro
export interface Props { id: string; title: string; }
const { id, title } = Astro.props;
---
<section id={id} class="section">
  <h2 class="head"><span class="hash" aria-hidden="true">## </span>{title}</h2>
  <div class="body">
    <slot />
  </div>
</section>

<style>
  .section { margin-top: var(--s12); }
  .head {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fs-md);
    font-weight: 700;
    margin: 0 0 var(--s4);
    letter-spacing: -0.005em;
    animation: fadein 380ms ease both;
  }
  .head .hash { color: var(--comment); font-weight: 400; }
  .body { font-family: var(--font-mono); }
  @keyframes fadein {
    from { opacity: 0; transform: translateY(2px); }
    to   { opacity: 1; transform: none; }
  }
</style>
