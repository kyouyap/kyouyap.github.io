---
// project/src/components/TerminalHero.astro
export interface Props {
  command?: string; // default: "whoami"
  name: string;
  role: string;
  tagline: string;
}
const { command = "whoami", name, role, tagline } = Astro.props;
---
<header class="hero">
  <div class="prompt">
    <span class="dollar">$</span> {command}
  </div>
  <h1 class="name">
    {name}<span class="cursor" aria-hidden="true">▮</span>
  </h1>
  <p class="meta">// {role}</p>
  <p class="meta">// {tagline}</p>
</header>

<style>
  .hero { padding: var(--s8) 0 var(--s4); }
  .prompt {
    color: var(--comment);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
  }
  .prompt .dollar { color: var(--comment); }
  .name {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fs-3xl);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: var(--s2) 0 var(--s4);
  }
  .meta {
    color: var(--comment);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    margin: 0;
  }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 0.85em;
    background: var(--accent);
    margin-left: 0.2em;
    vertical-align: -0.05em;
    animation: blink 1s steps(2) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .cursor { animation: none; }
  }
</style>
